{
  "manifest_version": 3,
  "name": "Voltar à Harumi",
  "version": "1.1",
  "description": "Botão fixo para fechar o app e voltar à Harumi Auto OS.",
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
